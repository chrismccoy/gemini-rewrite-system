# Unified RSS Curator Configuration

# Port to listen on (Default: 3000)
PORT=3000

# Environment: 'development' or 'production'
# Note: In 'production', session cookies are set to Secure (HTTPS only).
NODE_ENV=development

# Google Gemini AI
# Obtain your free API Key from Google AI Studio:
# https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_YOUR_API_KEY_HERE

# Credentials required to access the Dashboard
ADMIN_USER=admin
ADMIN_PASS=change_me_to_something_secure

# Secret key used to sign the session ID cookie.
SESSION_SECRET=long_random_string_for_cookie_signing

