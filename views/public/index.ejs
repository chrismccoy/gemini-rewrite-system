<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Curated Feed</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans">
    <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight">Curated Insights</h1>
            <p class="mt-4 text-xl text-gray-500">Hand-picked and rewritten by AI.</p>
        </div>

        <div class="space-y-8">
            <% if(items.length === 0) { %>
                <div class="text-center py-10">
                    <p class="text-gray-500 text-lg">No curated posts yet.</p>
                    <p class="text-sm text-gray-400">Login to the admin dashboard to rewrite content.</p>
                </div>
            <% } %>

            <% items.forEach(item => { %>
                <div class="bg-white overflow-hidden shadow rounded-lg hover:shadow-md transition-shadow">
                    <div class="px-4 py-5 sm:p-6">
                        <div class="flex items-center justify-between mb-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                <%= item.source_name || 'Curated Source' %>
                            </span>
                            <span class="text-sm text-gray-400">
                                <%= new Date(item.created_at).toLocaleDateString() %>
                            </span>
                        </div>

                        <h3 class="text-2xl leading-8 font-bold text-gray-900 mb-3">
                            <a href="<%= item.original_link %>" target="_blank" class="hover:text-blue-600 transition">
                                <%= item.title %>
                            </a>
                        </h3>

                        <div class="prose max-w-none text-gray-600">
                            <%- item.content %>
                        </div>

                        <div class="mt-6 border-t border-gray-100 pt-4">
                            <a href="<%= item.original_link %>" target="_blank" class="text-sm font-medium text-blue-600 hover:text-blue-500 flex items-center">
                                Read original source <span aria-hidden="true" class="ml-1">&rarr;</span>
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
        
        <div class="mt-12 text-center">
            <a href="/login" class="text-sm text-gray-400 hover:text-gray-600">Admin Login</a>
        </div>
    </div>
</body>
</html>
