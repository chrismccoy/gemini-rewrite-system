<%- include('../partials/adminHeader') %>

<div class="bg-white shadow rounded-lg p-6 max-w-4xl relative">
    
    <div class="mb-6 border-b border-gray-200 pb-4 flex flex-col sm:flex-row sm:justify-between sm:items-center">
        <div class="mb-4 sm:mb-0">
            <h3 class="text-lg font-medium text-gray-900">AI Configuration</h3>
            <p class="text-sm text-gray-500">Customize how the AI rewrites your content.</p>
        </div>
        
        <button type="button" onclick="openResetModal()" class="inline-flex items-center px-3 py-1.5 border border-red-300 shadow-sm text-xs font-medium rounded text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors">
            ↺ Reset to Default
        </button>
    </div>

    <form action="/admin/settings" method="POST">
        <div class="mb-6">
            <label for="prompt" class="block text-sm font-bold text-gray-700 mb-2">
                System Prompt
            </label>
            <p class="text-xs text-gray-500 mb-2">
                Instructions for the AI. You can define the tone, formatting (HTML), and length here.
            </p>
            <textarea 
                id="prompt" 
                name="prompt" 
                rows="12" 
                class="shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md p-3 font-mono text-gray-800"
                required
            ><%= prompt %></textarea>
        </div>

        <div class="flex items-center justify-end">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded focus:outline-none focus:shadow-outline transition duration-150">
                Save Settings
            </button>
        </div>
    </form>
</div>

<div id="resetModal" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity backdrop-blur-sm"></div>
  
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
      <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
        
        <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border-t-4 border-red-600">
          <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
            <div class="sm:flex sm:items-start">
              <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                </svg>
              </div>
              <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
                <h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">Reset System Prompt?</h3>
                <div class="mt-2">
                  <p class="text-sm text-gray-500">
                    Are you sure you want to reset the AI prompt to the system default? This action cannot be undone and your custom prompt customization will be lost.
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
            <form action="/admin/settings/reset" method="POST">
                <button type="submit" class="inline-flex w-full justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:ml-3 sm:w-auto">
                    Yes, Reset Everything
                </button>
            </form>
            <button type="button" onclick="closeResetModal()" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">
                Cancel
            </button>
          </div>
        </div>
      </div>
    </div>
</div>

<script>
    function openResetModal() {
        document.getElementById('resetModal').classList.remove('hidden');
    }

    function closeResetModal() {
        document.getElementById('resetModal').classList.add('hidden');
    }

    document.getElementById('resetModal').addEventListener('click', function(e) {
        if (e.target === this.querySelector('.fixed.inset-0.z-10')) {
            closeResetModal();
        }
    });
</script>

<%- include('../partials/adminFooter') %>
