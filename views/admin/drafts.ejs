<%- include('../partials/adminHeader') %>

<div class="bg-white shadow rounded-lg overflow-hidden relative">
    <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg leading-6 font-medium text-gray-900">Curated Drafts</h3>
        <p class="mt-1 text-sm text-gray-500">
            Review your AI-generated content here. 
            <span class="text-red-500 font-medium">Deleting a draft</span> allows you to re-write it from the Dashboard.
        </p>
    </div>

    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title / Excerpt</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Source</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            <% if(drafts.length === 0) { %>
                <tr>
                    <td colspan="4" class="px-6 py-10 text-center text-gray-500 italic">
                        No drafts created yet. Go to the <a href="/admin/dashboard" class="text-blue-600 hover:underline">Dashboard</a> to rewrite content.
                    </td>
                </tr>
            <% } %>

            <% drafts.forEach(draft => { %>
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4">
                        <div class="text-sm font-medium text-gray-900"><%= draft.title %></div>
                        <div class="text-xs text-gray-500 mt-1">
                            <%= draft.content.replace(/<[^>]*>?/gm, '').substring(0, 80) %>...
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        <%= draft.source_name || 'Unknown' %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        <%= new Date(draft.created_at).toLocaleDateString() %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <a href="<%= draft.original_link %>" target="_blank" class="text-blue-600 hover:text-blue-900 mr-4" title="View Original">
                            Original ↗
                        </a>
                        
                        <button type="button" 
                                onclick="openDeleteModal('<%= draft.id %>')"
                                class="text-red-600 hover:text-red-900 font-bold transition-colors">
                            Delete 🗑
                        </button>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<div id="deleteModal" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity backdrop-blur-sm"></div>
  
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
      <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
        
        <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border-t-4 border-red-600">
          <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
            <div class="sm:flex sm:items-start">
              <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                </svg>
              </div>
              <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
                <h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">Delete Draft</h3>
                <div class="mt-2">
                  <p class="text-sm text-gray-500">
                    Are you sure you want to delete this draft? This will remove it from the curated list and allow you to import it again from the dashboard. This action cannot be undone.
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
            <a id="confirmDeleteBtn" href="#" class="inline-flex w-full justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:ml-3 sm:w-auto">
                Yes, Delete Draft
            </a>
            <button type="button" onclick="closeDeleteModal()" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">
                Cancel
            </button>
          </div>
        </div>
      </div>
    </div>
</div>

<script>
    function openDeleteModal(draftId) {
        const deleteUrl = '/admin/drafts/delete/' + draftId;
        document.getElementById('confirmDeleteBtn').setAttribute('href', deleteUrl);
        
        document.getElementById('deleteModal').classList.remove('hidden');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
    }

    document.getElementById('deleteModal').addEventListener('click', function(e) {
        if (e.target === this.querySelector('.fixed.inset-0.z-10')) {
            closeDeleteModal();
        }
    });
</script>

<%- include('../partials/adminFooter') %>
