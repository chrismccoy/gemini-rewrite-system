<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Unified Curator</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
</head>
<body class="bg-gray-100 font-sans antialiased h-screen flex overflow-hidden">

    <aside class="w-64 bg-gray-900 text-white flex flex-col flex-shrink-0">
        <div class="p-6">
            <h1 class="text-xl font-bold tracking-wider">Unified Curator</h1>
        </div>
        <nav class="flex-1 px-2 space-y-1">
            <a href="/admin/dashboard" class="group flex items-center px-2 py-2 text-sm font-medium rounded-md hover:bg-gray-800 <%= title === 'AI Dashboard' ? 'bg-gray-800 text-white' : 'text-gray-300' %>">
               🤖 AI Dashboard
            </a>
            <a href="/admin/feeds" class="group flex items-center px-2 py-2 text-sm font-medium rounded-md hover:bg-gray-800 <%= title === 'Manage Feeds' ? 'bg-gray-800 text-white' : 'text-gray-300' %>">
               📡 Manage Feeds
            </a>
            <a href="/admin/drafts" class="group flex items-center px-2 py-2 text-sm font-medium rounded-md hover:bg-gray-800 <%= title === 'Drafts' ? 'bg-gray-800 text-white' : 'text-gray-300' %>">
               📝 Drafts
            </a>
            <a href="/admin/settings" class="group flex items-center px-2 py-2 text-sm font-medium rounded-md hover:bg-gray-800 <%= title === 'AI Settings' ? 'bg-gray-800 text-white' : 'text-gray-300' %>">
               ⚙️ AI Settings
            </a>
        </nav>
        <div class="p-4 border-t border-gray-800">
            <a href="/logout" class="block text-red-400 hover:text-white text-sm font-medium mb-3">🚪 Logout</a>
            <a href="/" target="_blank" class="block text-gray-400 hover:text-white text-sm">View Public Site →</a>
        </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <header class="bg-white shadow-sm flex items-center justify-between h-16 px-6">
            <h2 class="text-xl font-semibold text-gray-800"><%= title %></h2>
        </header>

        <main class="flex-1 overflow-auto p-6">
